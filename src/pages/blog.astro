---
import Layout from "../layouts/Layout.astro";
import { getMediumPosts, MEDIUM_PROFILE } from "../lib/medium";

export const prerender = false;

const posts = await getMediumPosts();

Astro.response.headers.set(
    "Cache-Control",
    posts.length
        ? "public, s-maxage=3600, stale-while-revalidate=86400"
        : "public, s-maxage=300",
);

const fmt = new Intl.DateTimeFormat("es-CL", { day: "numeric", month: "short", year: "numeric" });
---

<Layout
    active="blog"
    title="Blog de desarrollo web y SEO | Raimundo del Río"
    description="Artículos sobre desarrollo web, arquitectura frontend, rendimiento y SEO técnico, escritos por Raimundo del Río a partir de proyectos reales."
    jsonLd={[
        {
            "@context": "https://schema.org",
            "@type": "Blog",
            name: "Notas de desarrollo",
            url: `${Astro.url.origin}/blog`,
            author: { "@type": "Person", name: "Raimundo del Río", url: MEDIUM_PROFILE },
        },
    ]}
>
    <main class="pt-[72px]">
        <header class="section !pb-12">
            <div class="container-x grid-12">
                <div class="col-span-12 md:col-span-8">
                    <h1 class="h1 mb-4" data-i18n="blog.heading">Notas de desarrollo</h1>
                    <p class="text-muted max-w-[56ch]" data-i18n="blog.intro">
                        Escribo sobre lo que aprendo construyendo sitios y productos: arquitectura, rendimiento, SEO y flujo de trabajo.
                    </p>
                </div>
            </div>
        </header>

        <section class="pb-[clamp(64px,9vw,112px)]">
            <div class="container-x">
                <div class="max-w-[960px]">
                    {
                        posts.length > 0 ? (
                            <ul class="rule">
                                {posts.map((post) => (
                                    <li class="rule-b">
                                        <a
                                            href={post.url}
                                            target="_blank"
                                            rel="noopener"
                                            class="group grid md:grid-cols-[minmax(0,1fr)_200px] gap-6 py-8 items-center hover:bg-surface transition-colors"
                                        >
                                            <div>
                                                <h2 class="h4 mb-1">{post.title}</h2>
                                                <p class="small text-muted mb-3">
                                                    <time datetime={post.date.toISOString()}>{fmt.format(post.date)}</time>
                                                    <span aria-hidden="true"> · </span>
                                                    {post.readMinutes} min
                                                </p>
                                                <p class="text-muted max-w-[62ch]">{post.excerpt}</p>
                                                {post.tags.length > 0 && (
                                                    <ul class="mt-4 flex flex-wrap gap-2">
                                                        {post.tags.map((tag) => (
                                                            <li class="chip">{tag.replace(/-/g, " ")}</li>
                                                        ))}
                                                    </ul>
                                                )}
                                            </div>
                                            {post.image && (
                                                <img
                                                    src={post.image}
                                                    alt=""
                                                    loading="lazy"
                                                    decoding="async"
                                                    width="200"
                                                    height="130"
                                                    class="hidden md:block w-[200px] h-[130px] object-cover"
                                                />
                                            )}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        ) : (
                            <div class="card p-9">
                                <p class="text-muted" data-i18n="blog.empty">No pude cargar los artículos en este momento.</p>
                            </div>
                        )
                    }

                    <a href={MEDIUM_PROFILE} target="_blank" rel="noopener" class="btn btn-primary btn-lg mt-10">
                        <span data-i18n="blog.all">Ver todos en Medium</span>
                        <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_outward</span>
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>
