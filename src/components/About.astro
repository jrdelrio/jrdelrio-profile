---
import { Image } from "astro:assets";
import profile from "../assets/profile.png";

const timeline = [
    {
        key: "spain",
        place: "España · 2 años",
        body: "Trabajé como desarrollador en Compensa Capital Humano, una plataforma de gestión de recursos humanos. Ahí me formé construyendo producto para usuarios reales.",
    },
    {
        key: "back",
        place: "Santiago · 2025",
        body: "Volví a Chile con una idea clara: ofrecer a los negocios de aquí el mismo estándar técnico con el que trabajaba afuera.",
    },
    {
        key: "chili",
        place: "Chilisites · hoy",
        body: "Fundé Chilisites, donde hacemos diseño y desarrollo web completo y marketing digital. Ayudamos a negocios a captar clientes y crecer, y a quienes parten a construir su empresa desde lo digital.",
    },
];

const stack = [
    { key: "front", label: "Frontend", items: ["Next.js", "Astro", "React", "Tailwind"] },
    { key: "cms", label: "Contenido", items: ["Sanity", "Shopify", "WordPress"] },
    { key: "back", label: "Backend y datos", items: ["Django", "Flask", "PostgreSQL", "Supabase"] },
    { key: "ops", label: "Correo y operación", items: ["Resend", "Zoho"] },
];
---

<section class="section" id="about">
    <div class="container-x">
        <div class="grid-12 gap-y-12">
            <div class="col-span-12 md:col-span-4">
                <div class="md:sticky md:top-28">
                    <Image
                        src={profile}
                        alt="Retrato de Raimundo del Río"
                        widths={[320, 480, 640]}
                        sizes="(min-width: 768px) 30vw, 90vw"
                        class="w-full max-w-[400px] aspect-[4/5] object-cover object-top mb-6"
                    />
                    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                        <a href="/CV_Jose_Raimundo_del_Rio_Domeyko.pdf" download class="btn btn-primary btn-md">
                            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">download</span>
                            <span data-i18n="about.cv">Descargar CV</span>
                        </a>
                        <a href="https://www.linkedin.com/in/jrdelriod/" target="_blank" rel="noopener" class="link">LinkedIn</a>
                    </div>
                </div>
            </div>

            <div class="col-span-12 md:col-span-7 md:col-start-6">
                <h2 class="h2 mb-6" data-i18n="about.heading">
                    Construyo sitios que se ven bien, cargan rápido y ayudan a vender.
                </h2>
                <p class="text-stone-text max-w-[60ch] mb-16" data-i18n="about.body">
                    Soy desarrollador web full-stack. Me hago cargo del proyecto completo: diseño, desarrollo, contenido autogestionable y todo lo que hace falta para que el sitio quede funcionando.
                </p>

                <ol class="border-l border-[color:var(--border-default)] mb-20">
                    {
                        timeline.map((t) => (
                            <li class="relative pl-8 pb-10 last:pb-0">
                                <span class="absolute -left-[4px] top-[9px] w-[7px] h-[7px] bg-stone" aria-hidden="true" />
                                <h3 class="h4 mb-2" data-i18n={`about.t.${t.key}.place`}>{t.place}</h3>
                                <p class="text-stone-text max-w-[60ch]" data-i18n={`about.t.${t.key}.body`}>{t.body}</p>
                            </li>
                        ))
                    }
                </ol>

                <h3 class="h4 mb-6" data-i18n="about.stack_label">Stack con el que trabajo</h3>
                <dl class="grid sm:grid-cols-2 gap-x-10 gap-y-7">
                    {
                        stack.map((g) => (
                            <div class="rule pt-4">
                                <dt class="label mb-1" data-i18n={`about.stack.${g.key}`}>{g.label}</dt>
                                <dd class="mono text-stone-dark">{g.items.join(" · ")}</dd>
                            </div>
                        ))
                    }
                </dl>
            </div>
        </div>
    </div>
</section>
