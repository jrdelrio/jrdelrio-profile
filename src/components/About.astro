---
import { Image } from "astro:assets";
import profile from "../assets/profile.png";

const timeline = [
    {
        key: "spain",
        place: "España · 2 años",
        body: "Trabajé como desarrollador en Compensa Capital Humano, una plataforma de gestión de recursos humanos. Ahí me formé construyendo producto para usuarios reales.",
    },
    {
        key: "back",
        place: "Santiago · 2025",
        body: "Volví a Chile con una idea clara: ofrecer a los negocios de aquí el mismo estándar técnico con el que trabajaba afuera.",
    },
    {
        key: "chili",
        place: "Chilisites · hoy",
        body: "Fundé Chilisites, donde hacemos diseño y desarrollo web completo y marketing digital. Ayudamos a negocios a captar clientes y crecer, y a quienes parten a construir su empresa desde lo digital.",
    },
];

const stack = [
    { key: "front", label: "Frontend", items: ["Next.js", "Astro", "React", "TypeScript", "Tailwind"] },
    { key: "cms", label: "Contenido", items: ["Sanity", "Shopify", "WordPress"] },
    { key: "back", label: "Backend y datos", items: ["Django", "Flask", "PostgreSQL", "Supabase", "Docker"] },
    { key: "ops", label: "Correo y operación", items: ["Resend", "Zoho"] },
    { key: "ai", label: "Desarrollo con IA", items: ["Claude"] },
];

const offline = [
    { key: "music", label: "Música", value: "Rock, sobre todo. Canto y toco guitarra y piano." },
    { key: "bike", label: "Bicicleta", value: "Me muevo a todos lados en bici." },
    { key: "tennis", label: "Tenis", value: "Mi deporte para desconectarme." },
    { key: "chess", label: "Ajedrez", value: "Apertura favorita: la española." },
];
---

<section class="section" id="about">
    <div class="container-x">
        <div class="grid-12 gap-y-12">
            <div class="col-span-12 md:col-span-4">
                <div class="md:sticky md:top-28">
                    <Image
                        src={profile}
                        alt="Retrato de Raimundo del Río"
                        widths={[320, 480, 640]}
                        sizes="(min-width: 768px) 30vw, 90vw"
                        class="w-full max-w-[400px] aspect-[4/5] object-cover object-top mb-6"
                    />
                    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                        <a href="/CV_Jose_Raimundo_del_Rio_Domeyko.pdf" download class="btn btn-primary btn-md">
                            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">download</span>
                            <span data-i18n="about.cv">Descargar CV</span>
                        </a>
                        <a href="https://www.linkedin.com/in/jrdelriod/" target="_blank" rel="noopener" class="link">LinkedIn</a>
                    </div>
                </div>
            </div>

            <div class="col-span-12 md:col-span-7 md:col-start-6">
                <h2 class="h2 mb-6" data-i18n="about.heading">
                    Construyo sitios que se ven bien, cargan rápido y ayudan a vender.
                </h2>
                <p class="text-muted max-w-[60ch] mb-16" data-i18n="about.body">
                    Soy desarrollador web full-stack. Me hago cargo del proyecto completo: diseño, desarrollo, contenido autogestionable y todo lo que hace falta para que el sitio quede funcionando.
                </p>

                <ol class="border-l border-[color:var(--border-default)] mb-20">
                    {
                        timeline.map((t) => (
                            <li class="relative pl-8 pb-10 last:pb-0">
                                <span class="absolute -left-[4px] top-[9px] w-[7px] h-[7px] bg-ink" aria-hidden="true" />
                                <h3 class="h4 mb-2" data-i18n={`about.t.${t.key}.place`}>{t.place}</h3>
                                <p class="text-muted max-w-[60ch]" data-i18n={`about.t.${t.key}.body`}>{t.body}</p>
                            </li>
                        ))
                    }
                </ol>

                <h3 class="h4 mb-4" data-i18n="about.stack_label">Stack con el que trabajo</h3>
                <div class="code-block overflow-hidden">
                    <p class="label px-5 py-2.5 rule-b" aria-hidden="true">stack.md</p>
                    <dl class="px-5 py-4 grid grid-cols-1 sm:grid-cols-[max-content_1fr] gap-x-6 gap-y-1.5">
                        {
                            stack.map((g) => (
                                <>
                                    <dt class="text-muted" data-i18n={`about.stack.${g.key}`}>{g.label}</dt>
                                    <dd class="text-ink mb-2 sm:mb-0">{g.items.join(" · ")}</dd>
                                </>
                            ))
                        }
                    </dl>
                </div>

                <h3 class="h4 mt-16 mb-2" data-i18n="about.offline_label">Fuera del código</h3>
                <p class="text-muted max-w-[60ch] mb-4" data-i18n="about.offline_intro">
                    Además de programador, soy músico aficionado.
                </p>
                <div class="code-block overflow-hidden">
                    <p class="label px-5 py-2.5 rule-b" aria-hidden="true">off-duty.md</p>
                    <dl class="px-5 py-4 grid grid-cols-1 sm:grid-cols-[max-content_1fr] gap-x-6 gap-y-1.5">
                        {
                            offline.map((o) => (
                                <>
                                    <dt class="text-muted" data-i18n={`about.off.${o.key}`}>{o.label}</dt>
                                    <dd class="text-ink mb-2 sm:mb-0" data-i18n={`about.off.${o.key}.v`}>{o.value}</dd>
                                </>
                            ))
                        }
                    </dl>
                    <p class="label px-5 py-2.5 rule" data-i18n="about.off.chess.n">1.e4 e5 2.Cf3 Cc6 3.Ab5</p>
                </div>
            </div>
        </div>
    </div>
</section>
