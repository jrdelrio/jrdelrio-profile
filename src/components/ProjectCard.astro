---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";
import { projectLogo } from "../data/project-logos";

interface Props {
    project: Project;
}
const { project: p } = Astro.props;
const host = new URL(p.url).hostname.replace(/^www\./, "");
const logo = projectLogo(p.slug);
---

<a href={p.url} target="_blank" rel="noopener noreferrer" class="card group flex flex-col h-full overflow-hidden">
    <div class="aspect-16/10 overflow-hidden bg-surface rule-b flex items-center justify-center p-8">
        {logo ? (
            <Image
                src={logo}
                alt={`Logo de ${p.name}`}
                widths={[200, 400]}
                sizes="(min-width: 1024px) 20vw, 40vw"
                class="max-h-37.5 max-w-full w-auto h-auto object-contain"
            />
        ) : (
            <span class="mono text-muted text-sm uppercase tracking-wide">{p.name}</span>
        )}
    </div>
    <div class="flex flex-col flex-1 p-5 sm:p-6 md:p-9">
        <div class="flex items-start justify-between gap-3">
            <h3 class="h4">{p.name}</h3>
            <span class="material-symbols-outlined text-muted text-[20px] shrink-0" aria-hidden="true">north_east</span>
        </div>
        {p.hideHost ? <div class="mb-4" /> : <p class="small text-muted mb-4">{host}</p>}
        <p class="text-muted mb-5" data-i18n={`proj.${p.slug}`}>{p.summary.es}</p>
        <ul class="diff-list mb-6" aria-label="Qué construí">
            {p.features.map((f, i) => <li class="diff" data-i18n={`proj.${p.slug}.f${i}`}>{f.es}</li>)}
        </ul>
        <p class="mono text-muted mt-auto">{p.stack.join(" · ")}</p>
    </div>
</a>
