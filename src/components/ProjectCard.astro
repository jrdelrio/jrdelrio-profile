---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";
import { projectImage } from "../data/project-images";

interface Props {
    project: Project;
}
const { project: p } = Astro.props;
const host = new URL(p.url).hostname.replace(/^www\./, "");
---

<a href={p.url} target="_blank" rel="noopener" class="card !rounded-none group flex flex-col h-full">
    <div class="aspect-[16/10] overflow-hidden bg-sunken">
        <Image
            src={projectImage(p.slug)}
            alt={`Portada del sitio de ${p.name}`}
            widths={[400, 800, 1200]}
            sizes="(min-width: 1024px) 40vw, (min-width: 768px) 50vw, 100vw"
            class="w-full h-full object-cover object-top"
        />
    </div>
    <div class="flex flex-col flex-1 p-5 sm:p-6 md:p-9">
        <div class="flex items-start justify-between gap-3">
            <h3 class="h4">{p.name}</h3>
            <span class="material-symbols-outlined text-stone-text text-[20px] shrink-0" aria-hidden="true">north_east</span>
        </div>
        <p class="small text-stone-text mb-4">{host}</p>
        <p class="text-stone-text mb-5" data-i18n={`proj.${p.slug}`}>{p.summary.es}</p>
        <ul class="flex flex-wrap gap-2 mb-6">
            {p.features.map((f, i) => <li class="chip" data-i18n={`proj.${p.slug}.f${i}`}>{f.es}</li>)}
        </ul>
        <p class="mono text-stone-dark mt-auto">{p.stack.join(" · ")}</p>
    </div>
</a>
