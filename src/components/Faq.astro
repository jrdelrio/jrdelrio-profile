---
import { faqs } from "../data/faqs";
import JsonLd from "./JsonLd.astro";

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q.es,
        acceptedAnswer: { "@type": "Answer", text: f.a.es },
    })),
};
---

<section class="section" id="faq">
    <div class="container-x">
        <h2 class="h2 mb-14" data-i18n="faq.heading">Preguntas frecuentes</h2>

        <div class="grid-12">
            <ul class="rule col-span-12 lg:col-span-9">
                {
                    faqs.map((f) => (
                        <li class="rule-b">
                            <details class="group py-6">
                                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 [&::-webkit-details-marker]:hidden">
                                    <h3 class="h4" data-i18n={`faq.${f.key}.q`}>{f.q.es}</h3>
                                    <span class="shrink-0 font-mono text-muted group-open:hidden" aria-hidden="true">+</span>
                                    <span class="hidden shrink-0 font-mono text-muted group-open:inline" aria-hidden="true">−</span>
                                </summary>
                                <p class="text-muted max-w-[62ch] mt-4" data-i18n={`faq.${f.key}.a`}>{f.a.es}</p>
                            </details>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
    <JsonLd data={faqSchema} />
</section>
