---
import { faqs as homeFaqs, type Faq } from "../data/faqs";
import JsonLd from "./JsonLd.astro";

interface Props {
    /** Preguntas a mostrar. Por defecto, las del home. */
    items?: Faq[];
    /** Prefijo de las keys i18n (`${prefix}.${key}.q` / `.a`, `${prefix}.heading`). */
    prefix?: string;
    heading?: string;
    id?: string;
}

const { items = homeFaqs, prefix = "faq", heading = "Preguntas frecuentes", id = "faq" } = Astro.props;

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: items.map((f) => ({
        "@type": "Question",
        name: f.q.es,
        acceptedAnswer: { "@type": "Answer", text: f.a.es },
    })),
};
---

<section class="section" id={id}>
    <div class="container-x">
        <h2 class="h2 mb-14" data-i18n={`${prefix}.heading`}>{heading}</h2>

        <div class="grid-12">
            <ul class="rule col-span-12 lg:col-span-9">
                {
                    items.map((f) => (
                        <li class="rule-b">
                            <details class="group py-6">
                                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 [&::-webkit-details-marker]:hidden">
                                    <h3 class="h4" data-i18n={`${prefix}.${f.key}.q`}>{f.q.es}</h3>
                                    <span class="shrink-0 font-mono text-muted group-open:hidden" aria-hidden="true">+</span>
                                    <span class="hidden shrink-0 font-mono text-muted group-open:inline" aria-hidden="true">−</span>
                                </summary>
                                <p class="text-muted max-w-[62ch] mt-4" data-i18n={`${prefix}.${f.key}.a`}>{f.a.es}</p>
                            </details>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
    <JsonLd data={faqSchema} />
</section>
