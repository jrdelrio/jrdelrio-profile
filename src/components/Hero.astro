---
const stack = ["Next.js", "Astro", "Sanity", "Django", "PostgreSQL"];
---

<section class="min-h-[100svh] flex items-end">
    <div class="container-x w-full pt-40 pb-[clamp(48px,8vw,96px)]">
        <div class="grid-12">
            <div class="col-span-12 md:col-span-9 lg:col-span-8">
                <h1 class="display hero-in mb-6" style="--i:0">
                    Raimundo <span class="text-stone-text">del Río</span>
                </h1>

                <p class="hero-in lead text-stone-dark max-w-[46ch] mb-4" style="--i:1" data-i18n="hero.role">
                    Desarrollador web full-stack y fundador de Chilisites
                </p>

                <p class="hero-in text-stone-text max-w-[54ch] mb-10" style="--i:2" data-i18n="hero.desc">
                    Diseño y construyo sitios y plataformas con Next.js, Astro y Sanity, y me encargo de dejarlos funcionando: dominio, correos y hosting.
                </p>

                <div class="hero-in flex flex-wrap gap-4" style="--i:3">
                    <a href="/proyectos" class="btn btn-primary btn-lg">
                        <span data-i18n="hero.cta_projects">Ver proyectos</span>
                        <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_outward</span>
                    </a>
                    <a href="#contact" class="btn btn-secondary btn-lg" data-i18n="hero.cta_contact">Hablemos</a>
                </div>
            </div>
        </div>

        <div class="hero-in rule mt-16 pt-6 flex flex-wrap items-center justify-between gap-x-8 gap-y-3" style="--i:4">
            <ul class="mono text-[12px] sm:text-[13px] text-stone-text flex flex-wrap gap-x-3 sm:gap-x-6 gap-y-1">
                {stack.map((s) => <li>{s}</li>)}
            </ul>
            <p class="small text-stone-text flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-success" aria-hidden="true"></span>
                <span data-i18n="hero.badge">Disponible para nuevos proyectos</span>
            </p>
        </div>
    </div>
</section>
