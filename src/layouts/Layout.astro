---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.tsx";
import SEO from "../components/SEO.astro";
import JsonLd from "../components/JsonLd.astro";

interface Props {
    title?: string;
    description?: string;
    active?: "home" | "projects" | "services" | "blog";
    image?: string;
    noindex?: boolean;
    /** JSON-LD adicional específico de la página. */
    jsonLd?: Record<string, unknown>[];
}

const {
    title = "José Raimundo del Rio | Desarrollador Web Full-Stack",
    description = "Portafolio de José Raimundo del Rio, desarrollador web full-stack y fundador de Chilisites. Sitios y plataformas web a medida, e-commerce, SEO y marketing digital.",
    active = "home",
    image,
    noindex = false,
    jsonLd = [],
} = Astro.props;

const origin = new URL("/", Astro.site ?? Astro.url).href.replace(/\/$/, "");
const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${origin}/#person`,
    name: "José Raimundo del Río Domeyko",
    alternateName: "Raimundo del Río",
    jobTitle: "Desarrollador web full-stack",
    url: origin,
    image: `${origin}/portrait.jpg`,
    sameAs: [
        "https://www.linkedin.com/in/jrdelriod/",
        "https://github.com/jrdelrio",
        "https://medium.com/@jrdelriodom",
    ],
    knowsAbout: ["Next.js", "Astro", "Sanity", "Django", "SEO técnico"],
};
const websiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${origin}/#website`,
    name: "Raimundo del Río",
    url: origin,
    inLanguage: ["es", "en"],
    publisher: { "@id": `${origin}/#person` },
};
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />

        <SEO title={title} description={description} image={image} noindex={noindex} />
        <JsonLd data={[personSchema, websiteSchema, ...jsonLd]} />

        <!-- Favicon -->
        <link rel="icon" type="image/png" href="/favicons/favicon.png" />
        <meta name="generator" content={Astro.generator} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@300,0..1&display=swap"
            rel="stylesheet"
        />
        <meta name="theme-color" content="#f6f1e7" />

    </head>
    <body class="overflow-x-hidden">
        <Navbar active={active} />
        <slot />
        <Footer />
        <ChatWidget client:idle />

        <script>
            import { translations } from "../i18n/translations.js";

            const STORAGE_KEY = "lang";

            function currentLang() {
                const saved = localStorage.getItem(STORAGE_KEY);
                return saved === "en" || saved === "es" ? saved : "es";
            }

            function applyLang(lang) {
                const dict = translations[lang] || translations.es;
                document.documentElement.lang = lang;

                document.querySelectorAll("[data-i18n]").forEach((el) => {
                    const key = el.getAttribute("data-i18n");
                    if (dict[key] != null) el.innerHTML = dict[key];
                });

                document
                    .querySelectorAll("[data-i18n-placeholder]")
                    .forEach((el) => {
                        const key = el.getAttribute("data-i18n-placeholder");
                        if (dict[key] != null)
                            el.setAttribute("placeholder", dict[key]);
                    });

                document.querySelectorAll(".lang-btn").forEach((btn) => {
                    const isActive = btn.getAttribute("data-lang") === lang;
                    btn.classList.toggle("border-accent", isActive);
                    btn.classList.toggle("border-transparent", !isActive);
                    btn.classList.toggle("font-medium", isActive);
                    btn.setAttribute("aria-current", isActive ? "true" : "false");
                });
            }

            applyLang(currentLang());

            document.addEventListener("click", (e) => {
                const btn = e.target.closest(".lang-btn");
                if (!btn) return;
                const next = btn.getAttribute("data-lang");
                if (next === currentLang()) return;
                localStorage.setItem(STORAGE_KEY, next);
                applyLang(next);
                window.dispatchEvent(new CustomEvent("langchange", { detail: next }));
            });
        </script>
    </body>
</html>
