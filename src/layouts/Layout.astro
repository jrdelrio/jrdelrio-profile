---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.tsx";
import SEO from "../components/SEO.astro";
import JsonLd from "../components/JsonLd.astro";

interface Props {
    title?: string;
    description?: string;
    active?: "home" | "projects" | "services" | "blog";
    image?: string;
    noindex?: boolean;
    type?: "website" | "article";
    /** JSON-LD adicional específico de la página. */
    jsonLd?: Record<string, unknown>[];
}

const {
    title = "José Raimundo del Río | Desarrollador web full-stack en Chile",
    description = "José Raimundo del Río, desarrollador web full-stack en Chile y fundador de Chilisites. Sitios y plataformas a medida con Next.js y Astro, e-commerce y SEO.",
    active = "home",
    image,
    noindex = false,
    type = "website",
    jsonLd = [],
} = Astro.props;

const origin = new URL("/", Astro.site ?? Astro.url).href.replace(/\/$/, "");
const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${origin}/#person`,
    name: "José Raimundo del Río Domeyko",
    alternateName: ["José Raimundo del Río", "Raimundo del Río", "José Raimundo del Rio", "Raimundo del Rio"],
    jobTitle: "Desarrollador web full-stack",
    description: "Desarrollador web full-stack en Chile y fundador de Chilisites.",
    url: origin,
    image: `${origin}/portrait-800.jpg`,
    email: "mailto:raimundo@chilisites.com",
    address: {
        "@type": "PostalAddress",
        addressLocality: "Santiago",
        addressCountry: "CL",
    },
    knowsLanguage: ["es", "en"],
    worksFor: { "@id": `${origin}/#chilisites` },
    sameAs: [
        "https://www.linkedin.com/in/jrdelriod/",
        "https://github.com/jrdelrio",
        "https://medium.com/@jrdelriodom",
    ],
    knowsAbout: [
        "Desarrollo web",
        "Diseño web",
        "Next.js",
        "Astro",
        "React",
        "TypeScript",
        "Sanity",
        "Django",
        "PostgreSQL",
        "E-commerce",
        "SEO técnico",
    ],
};
const chilisitesSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${origin}/#chilisites`,
    name: "Chilisites",
    url: "https://www.chilisites.com",
    description: "Agencia de diseño y desarrollo web y marketing digital en Chile.",
    logo: `${origin}/brand/chilisites-logo.png`,
    founder: { "@id": `${origin}/#person` },
    areaServed: [{ "@type": "Country", name: "Chile" }, "Worldwide"],
};
const websiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${origin}/#website`,
    name: "José Raimundo del Río",
    url: origin,
    inLanguage: "es",
    publisher: { "@id": `${origin}/#person` },
};
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- Google Tag Manager -->
        <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-N4BVQRFF');</script>
        <!-- End Google Tag Manager -->

        <SEO title={title} description={description} image={image} noindex={noindex} type={type} />
        <JsonLd data={[personSchema, chilisitesSchema, websiteSchema, ...jsonLd]} />

        <!-- Favicon -->
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/png" sizes="192x192" href="/favicons/favicon-192.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="generator" content={Astro.generator} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@300,0..1&icon_names=arrow_outward,chat_bubble,close,download,menu,north_east,send&display=block"
            rel="stylesheet"
        />
        <meta name="theme-color" content="#f6f1e7" />

    </head>
    <body class="overflow-x-hidden">
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N4BVQRFF" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <Navbar active={active} />
        <slot />
        <Footer />
        <ChatWidget client:idle />

        <script>
            import { translations } from "../i18n/translations.js";

            const STORAGE_KEY = "lang";

            type Lang = "es" | "en";

            function currentLang(): Lang {
                const saved = localStorage.getItem(STORAGE_KEY);
                return saved === "en" || saved === "es" ? saved : "es";
            }

            function applyLang(lang: Lang) {
                const dict: Record<string, string> =
                    translations[lang] || translations.es;
                document.documentElement.lang = lang;

                document.querySelectorAll("[data-i18n]").forEach((el) => {
                    const key = el.getAttribute("data-i18n");
                    if (key && dict[key] != null) el.innerHTML = dict[key];
                });

                document
                    .querySelectorAll("[data-i18n-placeholder]")
                    .forEach((el) => {
                        const key = el.getAttribute("data-i18n-placeholder");
                        if (key && dict[key] != null)
                            el.setAttribute("placeholder", dict[key]);
                    });

                document.querySelectorAll(".lang-btn").forEach((btn) => {
                    const isActive = btn.getAttribute("data-lang") === lang;
                    btn.classList.toggle("border-accent", isActive);
                    btn.classList.toggle("border-transparent", !isActive);
                    btn.classList.toggle("font-medium", isActive);
                    btn.setAttribute("aria-current", isActive ? "true" : "false");
                });
            }

            applyLang(currentLang());

            document.addEventListener("click", (e) => {
                const btn = (e.target as Element | null)?.closest(".lang-btn");
                if (!btn) return;
                const next = btn.getAttribute("data-lang");
                if (next !== "es" && next !== "en") return;
                if (next === currentLang()) return;
                localStorage.setItem(STORAGE_KEY, next);
                applyLang(next);
                window.dispatchEvent(new CustomEvent("langchange", { detail: next }));
            });
        </script>
    </body>
</html>
